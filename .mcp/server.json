{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.EntityAdam/comfyui-workflow-mcp",
  "title": "ComfyUI Workflow MCP",
  "description": "Run validated ComfyUI workflows through the Model Context Protocol.",
  "version": "0.0.1-preview5",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "ComfyUi.WorkflowMcp",
      "version": "0.0.1-preview5",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "ComfyWorkflowMcp__BaseUrl",
          "value": "{comfyui_base_url}",
          "variables": {
            "comfyui_base_url": {
              "description": "ComfyUI server URL.",
              "isRequired": false,
              "isSecret": false,
              "default": "http://localhost:8188"
            }
          }
        },
        {
          "name": "ComfyWorkflowMcp__Directory",
          "value": "{directory}",
          "variables": {
            "directory": {
              "description": "Root directory containing settings.yaml, workflows, and input.",
              "isRequired": false,
              "isSecret": false
            }
          }
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/entityadam/comfyui-workflow-mcp",
    "source": "github"
  }
}
