<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ComfyUi.WorkflowMcp</RootNamespace>
    <Version>0.0.1-preview5</Version>
    <PackageId>ComfyUi.WorkflowMcp</PackageId>
    <ToolCommandName>comfyui-workflow-mcp</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>AI;ComfyUI;MCP;Model Context Protocol;server;stdio</PackageTags>
    <Authors>Adam Vincent</Authors>
    <Description>Simple Model Context Protocol bridge for validated ComfyUI workflows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/entityadam/comfyui-workflow-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/entityadam/comfyui-workflow-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../.mcp/server.json" Link=".mcp/server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
